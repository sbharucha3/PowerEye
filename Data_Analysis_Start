elif measured_frequency < allowable_frequency - frequency_tolerance:
    print(f"WARNING: Frequency too low! {measured_frequency:.4g} Hz")

# Check voltage harmonic distortion
if voltage_THD > 8:
    print(f"WARNING: High voltage distortion! THD = {voltage_THD:.4g}%")

# Check current harmonic distortion
if current_THD > allowable_current_THD:
    print(f"WARNING: High current distortion! THD = {current_THD:.4g}%")










